+// Calibrated-only Bolt runtime. Numerical search never runs in stabilizer.
+static scaPoly scrPlan[2];
+static scrResult scrScheduled;
+static bool scrScheduledValid,scrUnwind;
+static uint32_t scrPlanUs,scrSubmitUs;
+static float scrDeadline;
+static bool scCalibratedGetSetpoint(setpoint_t *setpoint,const state_t *state,float t,
+    uint32_t nowUs,bool fresh,const float position[3],const float velocity[3],
+    const float observed[3],const float body[3]) {
+  const uint32_t begin=(uint32_t)usecTimestamp();
+  const float dx=postReleaseAutoDirectionXY[0],dy=postReleaseAutoDirectionXY[1];
+  const float c=cosf(postReleaseAutoYawRad),s=sinf(postReleaseAutoYawRad);
+  const float ux=c*dx+s*dy,uy=-s*dx+c*dy;
+  const float mix[2][2]={{-uy,-ux},{-ux,uy}};
+  float angles[3]={observed[0],observed[1],observed[2]},euler[3];
+  // Match the output source used in the response fit, without changing PID
+  // estimator ownership. A post-release15 fit remains explicitly selectable.
+  if(scrModel.source==1){angles[0]=state->attitude.roll;angles[1]=state->attitude.pitch;}
+  postReleaseEulerRatesFromBody(angles[0],angles[1],body,euler);
+  float px[2]={0},pv[2]={0},pa[2]={0};
+  scQuality=estimatorKalmanGetSCurvePrediction(px,pv,pa,&scSourceAge);
+  static float hr[76],hp[76];
+  static scaModel model[2];
+  const bool history=prResponseHistory(nowUs,hr,hp);
+  scaState z[2]={{.v=dx*pv[0]+dy*pv[1]},{.v=-dy*pv[0]+dx*pv[1]}};
+  for(unsigned i=0;i<2;i++) {
+    model[i]=(scaModel){.closed=true};
+    for(unsigned j=0;j<2;j++) {
+      const float weight=mix[i][j]*mix[i][j];const prResponseAxis *a=&scrModel.axis[j];
+      model[i].delay+=weight*a->delay;model[i].wn+=weight*a->wn;
+      model[i].zeta+=weight*a->zeta;model[i].cgain+=weight*a->gain;
+      model[i].cbias+=mix[i][j]*radians(a->bias);
+      z[i].x+=mix[i][j]*radians(angles[j]);z[i].w+=mix[i][j]*radians(euler[j]);
+    }
+    if(history)for(unsigned k=0;k<76;k++)model[i].history[k]=radians(mix[i][0]*hr[k]+mix[i][1]*hp[k]);
+  }
+  if(!scActive) {
+    scActive=true;scBeginUs=scLastUs=scrPlanUs=scrSubmitUs=nowUs;
+    scrUnwind=false;scrScheduledValid=false;scrDeadline=6;scrUsedId=scrModel.id;
+    // Let an old pending worker job drain; its epoch can never be applied.
+    taskENTER_CRITICAL();scrEpoch++;scrReady=false;taskEXIT_CRITICAL();
+    for(unsigned i=0;i<2;i++)scaMake((scaRef){.x=z[i].x,.w=z[i].w},i?0:-atanf(3.6f/9.81f),.35f,0,&scrPlan[i]);
+    postReleaseAutoReplanCount++;
+  }
+  const float age=(uint32_t)(nowUs-scBeginUs)*1e-6f;
+  bool fault=postReleaseAutoStage==6 || !history || !scrUsedId || scQuality==0 || age>6;
+  if(fault){if(postReleaseAutoStage!=6)postReleaseAutoAbortReason=scQuality?8:1;postReleaseAutoStage=6;}
+  taskENTER_CRITICAL();
+  if(scrReady) {
+    if(scrReply.valid && scrReply.epoch==scrEpoch && (int32_t)(scrReply.activation-nowUs)>=0) {
+      scrScheduled=scrReply;scrScheduledValid=true;
+    }
+    scrReady=false;
+  }
+  taskEXIT_CRITICAL();
+  if(!fault && scrScheduledValid && (int32_t)(nowUs-scrScheduled.activation)>=0) {
+    // Reject discontinuous late activation; never rewind the curve clock.
+    if(nowUs-scrScheduled.activation<=15000u) {
+      memcpy(scrPlan,scrScheduled.plan,sizeof(scrPlan));scrPlanUs=scrScheduled.activation;
+      scrDeadline=(uint32_t)(scrPlanUs-scBeginUs)*1e-6f+scrScheduled.duration;
+      scrUnwind=true;postReleaseAutoReplanCount++;
+    } else scrLate++;
+    scrScheduledValid=false;
+  }
+  if(!fault)postReleaseAutoStage=scrUnwind?2:1;
+  const float planAge=(uint32_t)(nowUs-scrPlanUs)*1e-6f;
+  if(!fault && fresh && scQuality==2 && !scrScheduledValid && nowUs-scrSubmitUs>=40000u &&
+      (!scrUnwind || scrDeadline-age>SCR_LEAD_S+.22f)) {
+    taskENTER_CRITICAL();
+    if(!scrBusy && !scrPending) {
+      for(unsigned i=0;i<2;i++){scrMailbox.state[i]=z[i];scrMailbox.model[i]=model[i];scrMailbox.old[i]=scrPlan[i];}
+      scrMailbox.planAge=planAge;scrMailbox.remaining=scrDeadline-age;
+      scrMailbox.epoch=scrEpoch;scrMailbox.stamp=nowUs;scrMailbox.unwind=scrUnwind;
+      scrPending=scrBusy=true;scrSubmitUs=nowUs;
+    }
+    taskEXIT_CRITICAL();
+  }
+  float command[2];
+  for(unsigned i=0;i<2;i++)command[i]=fault?0:scaClosedCommand(scaEval(&scrPlan[i],planAge).x,&model[i]);
+  float norm=hypotf(command[0],command[1]);
+  if(norm>.395f){command[0]*=.395f/norm;command[1]*=.395f/norm;}
+  const float ref[3]={degrees(-uy*command[0]-ux*command[1]),degrees(-ux*command[0]+uy*command[1]),0};
+  memcpy(postReleaseAutoReferenceDeg,ref,sizeof(ref));
+  scPredV=z[0].v;scAlong=9.81f*tanf(command[0]);scCross=9.81f*tanf(command[1]);
+  scProfile.total=scrDeadline;postReleaseAutoRapidSetpointCount++;
+  if(!fault && scrUnwind && age>=scrDeadline && fresh && scQuality==2) {
+    const struct traj_eval hold={.pos=mkvec(position[0],position[1],postReleaseAutoHeightM),
+      .vel=vzero(),.acc=vzero(),.omega=vzero(),.yaw=postReleaseAutoYawRad};
+    if(plan_go_to_from(&planner,&hold,false,false,hold.pos,hold.yaw,0,t)==0) {
+      positionControllerResetXY(position[0],position[1]);postReleaseAutoStage=4;
+      postReleaseAutoHoldCount++;postReleaseAutoQueueHoldNotice(&hold,nowUs);return false;
