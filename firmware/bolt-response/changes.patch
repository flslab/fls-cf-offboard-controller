+PARAM_ADD_WITH_CALLBACK(PARAM_FLOAT, rZeta, &draft.axis[0].zeta, dirty)
+PARAM_ADD_WITH_CALLBACK(PARAM_FLOAT, rGain, &draft.axis[0].gain, dirty)
+PARAM_ADD_WITH_CALLBACK(PARAM_FLOAT, rBias, &draft.axis[0].bias, dirty)
+PARAM_ADD_WITH_CALLBACK(PARAM_FLOAT, pDelay, &draft.axis[1].delay, dirty)
+PARAM_ADD_WITH_CALLBACK(PARAM_FLOAT, pWn, &draft.axis[1].wn, dirty)
+PARAM_ADD_WITH_CALLBACK(PARAM_FLOAT, pZeta, &draft.axis[1].zeta, dirty)
+PARAM_ADD_WITH_CALLBACK(PARAM_FLOAT, pGain, &draft.axis[1].gain, dirty)
+PARAM_ADD_WITH_CALLBACK(PARAM_FLOAT, pBias, &draft.axis[1].bias, dirty)
