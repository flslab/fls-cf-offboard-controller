+  setpoint->position.z=postReleaseAutoHeightM;
+  setpoint->mode.roll=setpoint->mode.pitch=setpoint->mode.yaw=modeAbs;
+  setpoint->attitude.roll=ref[0];setpoint->attitude.pitch=ref[1];setpoint->attitude.yaw=degrees(postReleaseAutoYawRad);
+  uint32_t elapsed=(uint32_t)usecTimestamp()-begin;if(elapsed>scMaxUs)scMaxUs=elapsed;
+  (void)velocity;return true;
+}
