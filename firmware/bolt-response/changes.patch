+#include <string.h>
+#include "autoconf.h"
+#include "post_release_response.h"
+#include "supervisor.h"
+#include "param.h"
+#include "FreeRTOS.h"
+#include "task.h"
+
+static prResponseModel draft, applied;
+static uint32_t version=26092301u, commit, activeId;
+static uint8_t ready, error;
+// This build includes the calibrated planner and actual PID target history.
+#if defined(CONFIG_PLATFORM_SITL) || defined(CONFIG_ESTIMATOR_KALMAN_POST_RELEASE_HARDWARE_BRAKE)
+static uint8_t runtime=1;
+#else
+static uint8_t runtime=0;
+#endif
+static struct { uint32_t us; float r,p; } history[128];
+static unsigned head, count;
+static void dirty(void) {
+  if (supervisorIsArmed()) { error=1; return; }
+  taskENTER_CRITICAL(); ready=0;activeId=0; taskEXIT_CRITICAL();
+}
+static void apply(void) {
+  if (supervisorIsArmed()) { error=1; return; }
+  taskENTER_CRITICAL();
+  ready=0;activeId=0;error=0;
+  if (commit) {
+    if (commit!=draft.id || !prResponseValid(&draft)) error=2;
+    else {applied=draft;activeId=applied.id;ready=1;}
+  }
+  taskEXIT_CRITICAL();
+}
+bool prResponseGet(prResponseModel *out) {
+  taskENTER_CRITICAL();
+  const bool ok=ready;
+  if(ok)*out=applied;
+  taskEXIT_CRITICAL();
+  return ok;
+}
+void prResponseRecord(uint32_t nowUs,float rollDeg,float pitchDeg,bool powered) {
+  if(!powered || !isfinite(rollDeg) || !isfinite(pitchDeg)) {count=0;return;}
+  history[head].us=nowUs;history[head].r=rollDeg;history[head].p=pitchDeg;
+  head=(head+1)%128;if(count<128)count++;
+}
+bool prResponseHistory(uint32_t nowUs,float roll[76],float pitch[76]) {
+  // Same stabilizer thread is reader/writer. Walk backwards once, causal ZOH.
+  if(count<2)return false;
+  unsigned offset=1,index=(head+127)%128;
+  if((uint32_t)(nowUs-history[index].us)>10000)return false;
+  for(unsigned k=0;k<76;k++) {
+    const uint32_t targetAge=2000*k;
+    while((uint32_t)(nowUs-history[index].us)<targetAge) {
+      if(++offset>count)return false;
+      const unsigned previous=(index+127)%128;
+      if((uint32_t)(history[index].us-history[previous].us)>6000)return false;
+      index=previous;
+    }
+    if((uint32_t)(nowUs-history[index].us)-targetAge>10000)return false;
+    roll[75-k]=history[index].r;pitch[75-k]=history[index].p;
+  }
+  return true;
+}
