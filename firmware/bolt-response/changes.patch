+#include "post_release_response.h"
+#include "post_release_calibrated_job.h"
+static uint8_t scAdaptiveEnable;
+static uint32_t scAdaptiveVersion=26092303u;
+static bool scAdaptiveRunning;
+static prResponseModel scrModel;
+static scrJob scrMailbox;
+static scrResult scrReply;
+static bool scrPending,scrReady,scrBusy;
+static uint32_t scrEpoch,scrLate,scrWorkerMaxUs,scrUsedId;
+static uint16_t scrStackFree;
+static void scrWorker(void *arg);
+STATIC_MEM_TASK_ALLOC(scrWorker, 1536);
+static void scrWorker(void *arg) {
+  static scrJob job;
+  static scrResult result;
+  (void)arg;
+  while(1) {
+    taskENTER_CRITICAL();
+    bool run=scrPending;
+    if(run){job=scrMailbox;scrPending=false;}
+    taskEXIT_CRITICAL();
+    if(run) {
+      uint32_t begin=(uint32_t)usecTimestamp();
+      result=scrSolve(&job);
+      uint32_t now=(uint32_t)usecTimestamp(),elapsed=now-begin;
+      if(elapsed>scrWorkerMaxUs)scrWorkerMaxUs=elapsed;
+      scrStackFree=(uint16_t)uxTaskGetStackHighWaterMark(NULL);
+      taskENTER_CRITICAL();
+      if((int32_t)(now-result.activation)>=0){result.valid=false;scrLate++;}
+      scrReply=result;scrReady=true;scrBusy=false;
+      taskEXIT_CRITICAL();
+    }
+    vTaskDelay(1);
+  }
+}
