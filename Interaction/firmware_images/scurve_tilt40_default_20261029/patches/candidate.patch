+++ b/src/modules/interface/kalman_core/post_release_scurve_limits.h
@@ -0,0 +1,46 @@
+#pragma once
+#include <math.h>
+#include <stdbool.h>
+
+// Bounds for the velocity S-curve attitude executor only. Other brake modes
+// retain their original envelope. The attitude S-curve defaults to 40 degrees.
+#define PR_STOP_GRAVITY_M_S2 9.81f
+#define PR_STOP_DEG_TO_RAD 0.017453292519943295f
+#define PR_STOP_LEGACY_TILT_DEG 22.183041f
+#define PR_STOP_MAX_TILT_DEG 40.0f
+#define PR_STOP_DEFAULT_TILT_DEG PR_STOP_MAX_TILT_DEG
+// Rounded down from g*tan(40 deg); not a guarantee of physical acceleration.
+#define PR_STOP_MAX_DECEL_M_S2 8.23f
+
+// A larger default must not change/reject legacy polynomial, state-matched,
+// position, or velocity execution. The parameter belongs to this executor only.
+static inline float prStopRuntimeTilt(float requested,unsigned shape,unsigned execution,bool stateMatch) {
+  return shape==0 && execution==2 && !stateMatch ? requested : PR_STOP_LEGACY_TILT_DEG;
+}
+
+static inline bool prStopDecelValid(float cap) {
+  return isfinite(cap) && cap>0 && cap<=PR_STOP_MAX_DECEL_M_S2;
+}
+static inline bool prStopTiltValid(float tilt) {
+  return isfinite(tilt) && tilt>=.1f && tilt<=PR_STOP_MAX_TILT_DEG;
+}
+static inline float prStopAccelerationLimit(float tilt) {
+  return PR_STOP_GRAVITY_M_S2*tanf(tilt*PR_STOP_DEG_TO_RAD);
+}
+// The calibrated response controller uses g*angle(rad), not g*tan(angle).
+// Converting the angle limit in its own coordinates avoids commanding 48 deg
+// when the requested maximum is 40 deg.
+static inline float prStopLinearAccelerationLimit(float tilt) {
+  return PR_STOP_GRAVITY_M_S2*tilt*PR_STOP_DEG_TO_RAD;
+}
+static inline bool prStopWithinTilt(float cap,float tilt) {
+  return prStopDecelValid(cap) && prStopTiltValid(tilt) &&
+    cap<=prStopAccelerationLimit(tilt)+1e-5f;
+}
+// Norm clipping preserves direction and limits combined roll/pitch, rather
+// than allowing both axes independently to reach the maximum tilt.
+static inline bool prStopLimitXY(float value[2],float bound) {
+  const float mag=hypotf(value[0],value[1]);
+  if(mag<=bound)return false;
+  value[0]*=bound/mag;value[1]*=bound/mag;return true;
+}
